# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/zeke
# Separate database used by integration tests (wiped on every run)
TEST_DATABASE_URL=postgres://user:password@localhost:5432/zeke_test

# Session signing secret — generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
APP_URL=http://localhost:3000

# Google OAuth (optional — the Google button is hidden until both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic API key for the AI provider (optional — falls back to the built-in rule-based provider)
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# Shared secret for the scheduler endpoint (POST /api/cron/agents)
CRON_SECRET=
